{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "@opencode-ai/plugin-python-lsp"
  ],
  "permissions": [
    {
      "action": "shell",
      "resource": "pytest *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "streamlit run app.py",
      "effect": "allow"
    }
  ]
}